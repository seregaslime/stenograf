# Пример server/.env — скопируйте в server/.env и раскомментируйте нужное.
# Все переменные необязательны: без них сервер работает на дефолтах.
#
# Настроек моделей здесь больше нет — с 05.09.2026 адрес модели, ключ и выбор
# моделей живут в приложении, у каждого свои. Оставшиеся от прежних времён
# строки STENOGRAF_LLM_* и STENOGRAF_OLLAMA_URL сервер молча пропустит, но
# смысла в них нет — их лучше удалить, особенно ключ.

# --- База данных ---
# PostgreSQL. Значение по умолчанию совпадает с сервисом db из
# docker-compose.yml, поэтому обычно менять его не нужно. SQLite в проекте
# больше нет: самописные миграции на PRAGMA под два диалекта не живут.
# STENOGRAF_DATABASE_URL=postgresql+psycopg://stenograf:stenograf@127.0.0.1:5432/stenograf

# --- Поиск по прошлым встречам ---
# Модели здесь нет: вектор куска считает приложение своей моделью эмбеддингов и
# присылает готовым. Сервер векторы хранит и перебирает — для скалярного
# произведения модель не нужна.
# Сколько символов набирать в кусок разговора перед подсчётом вектора.
# STENOGRAF_SEARCH_CHUNK_CHARS=600
# Сколько кусков отдавать на один запрос.
# STENOGRAF_SEARCH_TOP_K=5

# --- Прочее (пример) ---
# STENOGRAF_ASR_ENGINE=gigaam
# Где считать модели: auto (видеокарта NVIDIA, иначе процессор), cuda, mps, cpu.
# Metal (mps) сам не выбирается: на Apple Silicon для whisper есть движок mlx,
# а GigaAM и ECAPA на Metal не мерялись. Недоступное устройство молча
# откатывается на процессор — конфиг ездит с машины на машину.
# STENOGRAF_ASR_DEVICE=auto

# --- Смена говорящего внутри реплики ---
# Двое, говорящие встык в одном канале, склеиваются в одну реплику: пауза между
# ними 80–280 мс, VAD её не видит. Реплика режется там, где голос слева и справа
# похож меньше порога. Подобран на живой записи (scripts/eval_turns.py), а не на
# синтезе: у синтезированных голосов любой порог выглядит хорошим.
# STENOGRAF_SPEAKER_TURN_THRESHOLD=0.24

# --- Версия ---
# Ставится при сборке образа (build-arg STENOGRAF_VERSION=<git sha>) и видна в
# /api/health. Локально остаётся "dev". Задавать руками незачем — по ней видно,
# отстала машина от репозитория или нет.
# STENOGRAF_VERSION=dev

# --- Доступ ---
# Кому браузер разрешит читать ответы сервера, вдобавок к локальным адресам
# (localhost и 127.0.0.1 с любым портом разрешены всегда — vite берёт свободный).
# «null» — это собранное приложение: оно грузится с file://, и Chromium шлёт
# такой Origin.
# CORS защищает пользователя браузера, а не сервер: сервер закрывает токен
# (см. «Доступ по токену» в README).
# STENOGRAF_CORS_ORIGINS=null
