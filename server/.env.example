# Пример server/.env — скопируйте в server/.env и раскомментируйте нужное.
# Все переменные необязательны: без них сервер работает на локальных моделях.

# --- Опциональный LLM по API (подсказки и резюме) ---
# По умолчанию используется локальная Ollama, данные не покидают контур.
# Формат endpoint — OpenAI-совместимый: подходит и для внутреннего сервера
# инференса организации (vLLM/TGI), и для внешних сервисов (OpenAI, Groq,
# OpenRouter), и для локальных (LM Studio, Ollama через /v1).
# Эти значения — дефолт. Их же можно ввести прямо в настройках приложения
# (адрес, ключ, модели, «Запросить модели») — тогда выбор сохранится в
# server/data/llm.json и перекроет эти переменные. Ключ на клиент не отдаётся.
# Переключение local <-> api — селектором в настройках приложения.

# STENOGRAF_LLM_PROVIDER=local
# STENOGRAF_LLM_API_BASE_URL=https://api.openai.com/v1
# STENOGRAF_LLM_API_KEY=sk-...
# STENOGRAF_LLM_API_SUMMARY_MODEL=gpt-4o-mini
# STENOGRAF_LLM_API_HINTS_MODEL=gpt-4o-mini

# --- Прочее (пример) ---
# STENOGRAF_OLLAMA_URL=http://127.0.0.1:11434
# STENOGRAF_ASR_ENGINE=gigaam
