# Пример server/.env — скопируйте в server/.env и раскомментируйте нужное.
# Все переменные необязательны: без них сервер работает на локальных моделях.

# --- Опциональный LLM по API (подсказки и резюме) ---
# По умолчанию используется локальная Ollama, данные не покидают контур.
# Пока поддерживается ТОЛЬКО Groq. Причина не в вендоре: стандарт OpenAI на
# /v1/models отдаёт лишь id/object/created/owned_by, а Groq добавляет
# context_window. Без размера контекста нельзя отсеять модели, которые не
# потянут наши промпты (у whisper 448 токенов, у prompt-guard 512), и
# пользователь узнал бы о проблеме уже во время встречи.
# Эти значения — дефолт. Их же можно ввести прямо в настройках приложения
# (адрес, ключ, модели, «Запросить модели») — тогда выбор сохранится в
# server/data/llm.json и перекроет эти переменные. Ключ на клиент не отдаётся.
# Переключение local <-> api — селектором в настройках приложения.

# STENOGRAF_LLM_PROVIDER=local
# STENOGRAF_LLM_API_BASE_URL=https://api.groq.com/openai/v1
# STENOGRAF_LLM_API_KEY=gsk_...
# STENOGRAF_LLM_API_SUMMARY_MODEL=openai/gpt-oss-120b
# STENOGRAF_LLM_API_HINTS_MODEL=openai/gpt-oss-20b
# Запасной лимит токенов в минуту — используется, только если измерить не вышло.
# Обычно измеряется сам при сохранении настроек (по заголовкам ответа провайдера).
# STENOGRAF_LLM_API_TPM_FALLBACK=6000

# --- Прочее (пример) ---
# STENOGRAF_OLLAMA_URL=http://127.0.0.1:11434
# STENOGRAF_ASR_ENGINE=gigaam
